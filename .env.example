# Secrets: do not commit .env and do not paste tokens into Discord/chat.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# DSH's currently running host, with NO token in its URL.
DSH_URL=http://127.0.0.1:19387
# Launch token from the authorized DSH root URL (?token=...).
DSH_TOKEN=
BOT_CONFIG=config.json
# Optional: Telegram-only or combined mode. Obtain from BotFather; never paste into chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CONFIG=telegram.config.json
